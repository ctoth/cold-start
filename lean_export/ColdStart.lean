example : ∀ a : Nat, ∀ b : Nat, ∀ c : Nat, Nat.mul (Nat.succ (Nat.mul a (Nat.succ c))) (Nat.succ (Nat.mul b (Nat.succ c))) = Nat.succ (Nat.mul (Nat.mul (Nat.succ c) (Nat.succ c)) (Nat.succ (Nat.mul a b))) → Nat.add a b = Nat.succ c :=
